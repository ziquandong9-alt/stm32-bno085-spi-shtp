PROJECT_NAME           = "STM32 BNO085 SPI/SHTP Driver"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Portable non-blocking BNO085 SPI/SHTP driver"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIRECTORY@
INPUT                  = BNO085_Driver/Inc BNO085_Driver/Port README.en.md
FILE_PATTERNS          = *.h *.md
USE_MDFILE_AS_MAINPAGE = README.en.md
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
